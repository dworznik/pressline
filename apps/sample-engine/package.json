{
  "name": "pressline-sample-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The sample Engine: a small template designer that speaks the Pressline DesignSource protocol. Copy it to start your own.",
  "scripts": {
    "dev": "vite dev --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect/platform": "^0.97.2",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@pressline/contract": "workspace:*",
    "@pressline/render": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "@vercel/blob": "^2.8.0",
    "effect": "^3.22.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@pressline/conformance": "workspace:*",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
