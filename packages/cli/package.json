{
  "name": "@pressline/cli",
  "version": "0.1.0",
  "description": "Operator CLI for a Pressline instance: doctor, catalog search and check, webhooks register, orders, reconcile, printfile check",
  "keywords": [
    "pressline",
    "cli",
    "print-on-demand",
    "printful",
    "stripe",
    "operator",
    "effect"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://pressline.0xff.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dworznik/pressline.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dworznik/pressline/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pressline": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@effect/cli": "^0.77.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
