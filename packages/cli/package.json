{
  "name": "@pressline/cli",
  "version": "0.1.1",
  "description": "Command line for a Pressline instance: the Operator's doctor, catalog, webhooks, orders, reconcile and printfile check, and the Engine developer's offers, engine conformance and engine preflight",
  "keywords": [
    "pressline",
    "cli",
    "print-on-demand",
    "printful",
    "stripe",
    "operator",
    "effect",
    "engine"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://pressline.0xff.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dworznik/pressline.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/dworznik/pressline/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pressline": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preflight": {
      "types": "./dist/preflight.d.ts",
      "import": "./dist/preflight.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@effect/cli": "^0.77.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@pressline/conformance": "workspace:^",
    "@pressline/contract": "workspace:^",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
