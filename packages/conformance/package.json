{
  "name": "@pressline/conformance",
  "version": "0.2.1",
  "description": "DesignSource conformance suite: run it against an Engine's base URL and learn whether it speaks the Pressline protocol before going live",
  "keywords": [
    "pressline",
    "conformance",
    "designsource",
    "protocol",
    "print-on-demand",
    "engine"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://pressline.0xff.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dworznik/pressline.git",
    "directory": "packages/conformance"
  },
  "bugs": {
    "url": "https://github.com/dworznik/pressline/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pressline-conformance": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@effect/cli": "^0.77.1",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@pressline/contract": "workspace:^",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
