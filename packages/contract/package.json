  },
  "peerDependencies": {
    "@effect/platform": "^0.97.0",
    "effect": "^3.22.0"
  },
  "devDependencies": {
    "@effect/platform": "^0.97.2",
    "effect": "^3.22.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
