{
  "name": "@pressline/contract",
  "version": "0.1.1",
  "description": "The DesignSource protocol: Printfile Spec, Spec Hash, request/response schemas and a typed client for Engines and Pressline",
  "keywords": [
    "pressline",
    "designsource",
    "protocol",
    "printfile",
    "print-on-demand",
    "effect",
    "schema"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://pressline.0xff.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dworznik/pressline.git",
    "directory": "packages/contract"
  },
  "bugs": {
    "url": "https://github.com/dworznik/pressline/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
