{
  "name": "@pressline/render",
  "version": "0.1.0",
  "description": "Render helper for Pressline Engines: fit, pad and stamp an image into a print-ready PNG for a Printfile Spec, on Node (sharp) or in a Worker (WASM)",
  "keywords": [
    "pressline",
    "render",
    "printfile",
    "png",
    "sharp",
    "wasm",
    "print-on-demand",
    "image"
  ],
  "license": "MIT",
  "type": "module",
  "homepage": "https://pressline.0xff.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dworznik/pressline.git",
    "directory": "packages/render"
  },
  "bugs": {
    "url": "https://github.com/dworznik/pressline/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/backends/node.d.ts",
      "import": "./dist/backends/node.js"
    },
    "./wasm": {
      "types": "./dist/backends/wasm.d.ts",
      "import": "./dist/backends/wasm.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@pressline/contract": "workspace:^",
    "@resvg/resvg-wasm": "^2.6.2",
    "sharp": "^0.35.4"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-wasm": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "dependencies": {
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1"
  },
  "devDependencies": {
    "@pressline/contract": "workspace:*",
    "@resvg/resvg-wasm": "^2.6.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
